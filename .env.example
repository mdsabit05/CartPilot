# Optional: use a PostgreSQL database for persistence.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cartpilot?schema=public"

# Optional: enable real LLM tool calling. If omitted, CartPilot uses its deterministic demo agent.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Razorpay test credentials. If omitted, checkout remains clearly labeled DEMO CHECKOUT.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
